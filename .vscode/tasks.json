{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Checker",
            "type": "shell",
            "command": "bash",
            "args": [
                ".vscode/run_checker.sh",
                "${relativeFile}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}
